# Universal Web - Nginx + PHP-FPM
# Un solo bloque server atiende todos los dominios (server_name _ o una lista).
# Copia este archivo a /etc/nginx/sites-available/universal-web y actívalo.

server {
    listen 80;
    listen [::]:80;
    server_name midominio.com www.midominio.com cafe.midominio.com;   # añade aquí todos tus dominios (o usa "_")

    root /var/www/universal-web/public;
    index index.php;

    client_max_body_size 110m;     # imágenes hasta 8 MB, vídeo y audio hasta 100 MB (ajusta también upload_max_filesize/post_max_size de PHP)

    # Archivos internos: nunca deben llegar al navegador (por si el root cambia)
    location ~ /\.(?!well-known) { deny all; }

    # Los archivos subidos jamás se ejecutan
    location ~* ^/media/.*\.(php[0-9]?|phtml|phar|pht|cgi|pl|py|sh)$ { return 403; }

    # Estáticos con caché
    location ~* \.(css|js|png|jpe?g|gif|webp|avif|svg|ico|woff2?)$ {
        try_files $uri =404;
        expires 7d;
        add_header Cache-Control "public";
        add_header X-Content-Type-Options "nosniff" always;
    }

    # Todo lo demás pasa por el controlador frontal
    location / {
        try_files $uri /index.php$is_args$args;
    }

    location = /index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param HTTP_AUTHORIZATION $http_authorization;   # necesario para el MCP
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;              # ajusta la versión, o usa 127.0.0.1:9000
        fastcgi_read_timeout 60s;
    }

    # Ningún otro .php es accesible
    location ~ \.php$ { return 404; }
}

# HTTPS: con certbot ("certbot --nginx -d midominio.com -d cafe.midominio.com") se añade solo.
