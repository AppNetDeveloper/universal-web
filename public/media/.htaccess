# Los archivos subidos nunca se ejecutan
Options -Indexes -ExecCGI

<FilesMatch "(?i)\.(php[0-9]?|phtml|phar|pht|phps|cgi|pl|py|sh|asp|aspx|jsp|shtml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_mime.c>
    RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pht .cgi .pl .py
    RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pht
</IfModule>

# Nunca interpretar el contenido: que el navegador respete el tipo declarado
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
